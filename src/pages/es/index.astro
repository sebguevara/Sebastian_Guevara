---
import Layout from "@/layouts/Layout.astro";
import Hero from "@/sections/Hero.astro";
import About from "@/sections/About.astro";
import Contact from "@/sections/Contact.astro";
import Experience from "@/sections/Experience.astro";
import Education from "@/sections/Education.astro";
import Projects from "@/sections/Projects.astro";
import SectionContainer from "@/components/ui/SectionContainer.astro";
import Footer from "@/sections/Footer.astro";
import { getLocale } from "@/consts/locale";
import { getSiteMeta } from "@/consts/site";

const site = getSiteMeta(getLocale(Astro.currentLocale));
---

<Layout title={site.title} description={site.description}>
  <main>
    <div
      class="flex w-full flex-col px-5 pb-28 pt-14 sm:px-8 lg:px-12 lg:pb-12 lg:pt-0"
    >
      <SectionContainer id="home">
        <Hero />
      </SectionContainer>
      <SectionContainer id="experience">
        <Experience />
      </SectionContainer>
      <SectionContainer id="projects">
        <Projects />
      </SectionContainer>
      <SectionContainer id="education">
        <Education />
      </SectionContainer>
      <SectionContainer id="about">
        <About />
      </SectionContainer>
      <SectionContainer id="contact">
        <Contact />
      </SectionContainer>
      <Footer />
    </div>
  </main>
</Layout>
