---
import Layout from "@/layouts/Layout.astro";
import Error from "@/sections/Error.astro";
import { getCopy } from "@/consts/copy";
import { getLocale } from "@/consts/locale";
import { getSiteMeta } from "@/consts/site";

const locale = getLocale(Astro.currentLocale);
const site = getSiteMeta(locale);
const copy = getCopy(locale);
---

<Layout
  description={site.description}
  title={`${site.title} — ${copy.meta.notFoundTitle}`}
>
  <main>
    <Error
      error="404"
      message={copy.error.notFound}
      contextMessage={copy.error.notFoundContext}
    />
  </main>
</Layout>
