---
import ExperienceItem from "@/components/experience/ExperienceItem.astro";
import SectionHeader from "@/components/ui/SectionHeader.astro";
import { getCopy } from "@/consts/copy";
import { getLocale } from "@/consts/locale";
import { getCv } from "@/lib/cv";

const locale = getLocale(Astro.currentLocale);
const copy = getCopy(locale);
const { work } = getCv(locale);
---

<div class="py-14 sm:py-20">
  <SectionHeader
    eyebrow={copy.sections.experience.eyebrow}
    title={copy.sections.experience.title}
  />
  <ol class="flex flex-col gap-20 sm:gap-24 lg:gap-32">
    {
      work.map((experience) => (
        <li>
          <ExperienceItem {...experience} />
        </li>
      ))
    }
  </ol>
</div>
