---
import EducationItem from "@/components/education/EducationItem.astro";
import SectionHeader from "@/components/ui/SectionHeader.astro";
import { getCopy } from "@/consts/copy";
import { getLocale } from "@/consts/locale";
import { getCv } from "@/lib/cv";

const locale = getLocale(Astro.currentLocale);
const copy = getCopy(locale);
const { education } = getCv(locale);
---

<div class="py-14 sm:py-20">
  <SectionHeader
    eyebrow={copy.sections.education.eyebrow}
    title={copy.sections.education.title}
  />
  <ol class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {
      education.map((item) => (
        <li class="flex">
          <EducationItem {...item} />
        </li>
      ))
    }
  </ol>
</div>
