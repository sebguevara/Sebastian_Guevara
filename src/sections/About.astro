---
import InterestCard from "@/components/about/InterestCard.astro";
import LanguageList from "@/components/about/LanguageList.astro";
import ProfilePhoto from "@/components/about/ProfilePhoto.astro";
import SkillCard from "@/components/about/SkillCard.astro";
import SectionHeader from "@/components/ui/SectionHeader.astro";
import { getCopy } from "@/consts/copy";
import { getLocale } from "@/consts/locale";
import { getCv } from "@/lib/cv";

const locale = getLocale(Astro.currentLocale);
const copy = getCopy(locale);
const { basics, skills, languages, interests } = getCv(locale);

const paragraphs =
  basics.about.length > 0 ? basics.about : [basics.summary];
---

<div class="py-14 sm:py-20">
  <SectionHeader
    eyebrow={copy.sections.about.eyebrow}
    title={copy.sections.about.title}
  />

  <div class="flex flex-col gap-10 lg:flex-row lg:items-start lg:gap-14">
    <div class="flex flex-col gap-5 lg:flex-1">
      {
        paragraphs.map((paragraph) => (
          <p class="text-base leading-relaxed text-muted sm:text-lg" data-animate="reveal">
            {paragraph}
          </p>
        ))
      }
    </div>

    <ProfilePhoto />
  </div>

  <div class="mt-12 sm:mt-16">
    <h3
      class="mb-4 font-mono text-xs uppercase tracking-[0.2em] text-faint"
      data-animate="reveal"
    >
      {copy.about.skills}
    </h3>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {skills.map((skill) => <SkillCard {...skill} />)}
    </div>
  </div>

  <div class="mt-12 grid gap-10 sm:mt-16 lg:grid-cols-[1fr_2.2fr] lg:gap-8">
    <div>
      <h3
        class="mb-4 font-mono text-xs uppercase tracking-[0.2em] text-faint"
        data-animate="reveal"
      >
        {copy.about.languages}
      </h3>
      <LanguageList items={languages} />
    </div>

    <div>
      <h3
        class="mb-4 font-mono text-xs uppercase tracking-[0.2em] text-faint"
        data-animate="reveal"
      >
        {copy.about.interests}
      </h3>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
        {interests.map((interest) => <InterestCard {...interest} />)}
      </div>
    </div>
  </div>
</div>
