---
import fs from "node:fs";
import Github from "@/components/icons/brands/Github.astro";
import Linkedin from "@/components/icons/brands/Linkedin.astro";
import X from "@/components/icons/brands/X.astro";
import Email from "@/components/icons/brands/Email.astro";
import Maps from "@/components/icons/brands/Maps.astro";
import Download from "@/components/icons/Download.astro";
import { getCopy } from "@/consts/copy";
import { getLocale, localizePath } from "@/consts/locale";
import { getCv } from "@/lib/cv";

const locale = getLocale(Astro.currentLocale);
const copy = getCopy(locale);
const { basics } = getCv(locale);

const { name, tagline, label, email, location, profiles } = basics;
const roles = label.split("|").map((segment) => segment.trim());

// Per-locale CV download — the button renders only when the PDF exists.
const cvHref = `/cv-${locale}.pdf`;
const hasCvPdf = fs.existsSync(`public/cv-${locale}.pdf`);

const projectsUrl = `${localizePath("/", locale)}#projects`;

const Icons: Record<string, any> = { GitHub: Github, LinkedIn: Linkedin, X };
---

<div
  class="flex min-h-[calc(100dvh-3.5rem)] flex-col justify-center py-12 lg:min-h-dvh"
  data-animate="hero"
>
  <p class="mb-5 hidden lg:block" data-hero-item>
    <span class="chip border-accent/30 text-accent">
      <span class="relative flex size-1.5">
        <span
          class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent opacity-60"
        ></span>
        <span class="relative inline-flex size-1.5 rounded-full bg-accent"
        ></span>
      </span>
      {copy.hero.available}
    </span>
  </p>
  <p
    class="eyebrow mb-4 flex flex-wrap items-center gap-x-2.5 gap-y-1.5"
    data-hero-item
  >
    {
      roles.map((role, index) => (
        <>
          {index > 0 && (
            <span class="text-faint" aria-hidden="true">
              ·
            </span>
          )}
          <span>{role}</span>
        </>
      ))
    }
  </p>
  <h1
    class="bg-linear-to-br from-ink via-ink to-muted bg-clip-text text-[2.75rem] font-extrabold leading-[1.05] tracking-tight text-transparent sm:text-6xl md:text-7xl"
    data-hero-item
  >
    {name}
  </h1>
  <p
    class="mt-6 max-w-xl text-base leading-relaxed text-muted sm:text-lg"
    data-hero-item
  >
    {tagline}
  </p>
  <p
    class="mt-4 flex items-center gap-1.5 font-mono text-xs text-faint"
    data-hero-item
  >
    <Maps class="size-3.5 text-accent" />
    {location.city}, {location.region}
  </p>

  <div class="mt-8 flex flex-wrap items-center gap-3" data-hero-item>
    <a href={`mailto:${email}`} class="btn-primary">
      <Email class="size-4" />
      {copy.hero.ctaContact}
    </a>
    <a href={projectsUrl} class="btn-ghost">
      {copy.hero.ctaProjects}
    </a>
    {
      hasCvPdf && (
        <a href={cvHref} download class="btn-ghost">
          <Download class="size-4" />
          {copy.hero.downloadCv}
        </a>
      )
    }
    <div class="mx-1 h-6 w-px bg-line"></div>
    {
      profiles.map((profile) => {
        const Icon = Icons[profile.network];
        return Icon ? (
          <a
            href={profile.url}
            target="_blank"
            rel="noopener"
            aria-label={profile.network}
            class="text-muted transition-colors duration-300 hover:text-accent"
          >
            <Icon class="size-5" />
          </a>
        ) : null;
      })
    }
  </div>
</div>
