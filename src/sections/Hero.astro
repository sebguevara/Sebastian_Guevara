---
import fs from "node:fs";
import Email from "@/components/icons/brands/Email.astro";
import Download from "@/components/icons/Download.astro";
import { getCopy } from "@/consts/copy";
import { getLocale } from "@/consts/locale";
import { getCv } from "@/lib/cv";

const locale = getLocale(Astro.currentLocale);
const copy = getCopy(locale);
const { basics } = getCv(locale);

const { name, tagline, email } = basics;
const [firstName, ...lastParts] = name.split(" ");
const lastName = lastParts.join(" ");

const cvFile = `sebastian_guevara_${locale}.pdf`;
const cvHref = `/${cvFile}`;
const hasCvPdf = fs.existsSync(`public/${cvFile}`);
---

<section class="hero" data-animate="hero">
  <div class="hero-role" data-hero-item>
    <span class="hero-role-mark" aria-hidden="true"></span>
    <p>{copy.hero.role}</p>
  </div>

  <h1 class="hero-name" data-hero-item>
    <span class="hero-name-line">{firstName}</span>
    {
      lastName && (
        <span class="hero-name-line hero-name-line--accent">{lastName}</span>
      )
    }
  </h1>

  <p class="hero-support" data-hero-item>{copy.hero.support}</p>

  <p class="hero-tagline" data-hero-item>{tagline}</p>

  <div class="hero-actions" data-hero-item>
    <div class="hero-ctas">
      <a href={`mailto:${email}`} class="btn-primary hero-cta">
        <Email class="size-4" />
        {copy.hero.ctaContact}
      </a>
      {
        hasCvPdf ? (
          <a href={cvHref} download={cvFile} class="btn-ghost hero-cta">
            <Download class="size-4" />
            {copy.hero.downloadCv}
          </a>
        ) : null
      }
    </div>
  </div>
</section>

<style>
  .hero {
    display: flex;
    min-height: calc(100dvh - 7.5rem);
    flex-direction: column;
    justify-content: center;
    padding-block: 2.5rem 3rem;
  }

  @media (min-width: 640px) {
    .hero {
      padding-block: 3.5rem;
    }
  }

  @media (min-width: 1024px) {
    .hero {
      min-height: 100dvh;
      padding-block: 4rem;
    }
  }

  .hero-role {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .hero-role-mark {
    display: block;
    width: 2rem;
    height: 2px;
    background: var(--color-accent);
    flex-shrink: 0;
  }

  .hero-role p {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  @media (min-width: 640px) {
    .hero-role p {
      font-size: 0.8125rem;
      letter-spacing: 0.32em;
    }

    .hero-role-mark {
      width: 2.75rem;
    }
  }

  .hero-name {
    margin: 1rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.02em;
  }

  .hero-name-line {
    display: block;
    font-size: clamp(3.25rem, 14vw, 7.5rem);
    font-weight: 800;
    line-height: 0.9;
    letter-spacing: -0.05em;
    color: var(--color-ink);
    text-wrap: balance;
  }

  .hero-name-line--accent {
    background: linear-gradient(
      135deg,
      var(--color-ink) 20%,
      var(--color-accent) 120%
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  @media (min-width: 1024px) {
    .hero-name {
      margin-top: 1.25rem;
    }

    .hero-name-line {
      font-size: clamp(4.5rem, 8.5vw, 8.25rem);
    }
  }

  .hero-support {
    margin: 1.25rem 0 0;
    max-width: 28rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    line-height: 1.5;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-faint);
  }

  @media (min-width: 640px) {
    .hero-support {
      margin-top: 1.5rem;
      font-size: 0.75rem;
      letter-spacing: 0.22em;
    }
  }

  .hero-tagline {
    margin: 1.5rem 0 0;
    max-width: 42rem;
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--color-ink);
    text-wrap: pretty;
  }

  @media (min-width: 640px) {
    .hero-tagline {
      margin-top: 1.75rem;
      font-size: 1.2rem;
      line-height: 1.75;
    }
  }

  .hero-actions {
    margin-top: 2rem;
  }

  @media (min-width: 640px) {
    .hero-actions {
      margin-top: 2.5rem;
    }
  }

  .hero-ctas {
    display: flex;
    width: 100%;
    flex-direction: column;
    gap: 0.75rem;
  }

  .hero-cta {
    width: 100%;
    justify-content: center;
  }

  @media (min-width: 640px) {
    .hero-ctas {
      width: auto;
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
    }

    .hero-cta {
      width: auto;
    }
  }
</style>
