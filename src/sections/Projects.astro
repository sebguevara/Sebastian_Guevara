---
import ProjectCard from "@/components/projects/ProjectCard.astro";
import ProjectCardCompact from "@/components/projects/ProjectCardCompact.astro";
import SectionHeader from "@/components/ui/SectionHeader.astro";
import { getCopy } from "@/consts/copy";
import { getLocale } from "@/consts/locale";
import { getCv } from "@/lib/cv";

const locale = getLocale(Astro.currentLocale);
const copy = getCopy(locale);
const { projects } = getCv(locale);

// Flagship products get the full card; the rest render compact.
const featured = projects.filter((project) => project.featured);
const others = projects.filter((project) => !project.featured);
---

<div class="py-14 sm:py-20">
  <SectionHeader
    eyebrow={copy.sections.projects.eyebrow}
    title={copy.sections.projects.title}
  />

  <div class="grid grid-cols-1 gap-12 lg:grid-cols-2 lg:gap-14">
    {featured.map((project) => <ProjectCard {...project} />)}
  </div>

  {
    others.length > 0 && (
      <>
        <h3
          class="mb-8 mt-24 font-mono text-xs uppercase tracking-[0.2em] text-faint sm:mt-28"
          data-animate="reveal"
        >
          {copy.projects.more}
        </h3>
        <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 sm:gap-8 lg:grid-cols-3 lg:gap-10">
          {others.map((project) => (
            <ProjectCardCompact {...project} />
          ))}
        </div>
      </>
    )
  }
</div>
