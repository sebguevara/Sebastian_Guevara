---
interface Props {
  href: string;
  /** External links open in a new tab; internal ones use ClientRouter. */
  external?: boolean;
  class?: string;
}

const { href, external = true, class: className } = Astro.props;
---

<a
  href={href}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener" : undefined}
  class:list={[
    "inline-flex items-center gap-2 rounded-full border border-line bg-elevated/60 px-4 py-2 text-sm font-medium text-ink transition-colors duration-300 hover:border-accent/40 hover:text-accent",
    className,
  ]}
>
  <slot />
</a>
