---
import { getCopy } from "@/consts/copy";
import { getLocale } from "@/consts/locale";

const copy = getCopy(getLocale(Astro.currentLocale));
---

<div
  class="lightbox"
  data-lightbox
  data-open="false"
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  aria-label={copy.lightbox.label}
>
  <button
    type="button"
    class="lightbox-close"
    data-lightbox-close
    aria-label={copy.lightbox.close}
  >
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-5">
      <path d="M18 6 6 18"></path>
      <path d="m6 6 12 12"></path>
    </svg>
  </button>

  <button
    type="button"
    class="lightbox-nav lightbox-nav--prev"
    data-lightbox-prev
    aria-label={copy.carousel.prev}
    hidden
  >
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="size-5">
      <path d="m15 18-6-6 6-6"></path>
    </svg>
  </button>

  <figure class="lightbox-stage">
    <img data-lightbox-image alt="" />
    <figcaption class="lightbox-counter" data-lightbox-counter></figcaption>
  </figure>

  <button
    type="button"
    class="lightbox-nav lightbox-nav--next"
    data-lightbox-next
    aria-label={copy.carousel.next}
    hidden
  >
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="size-5">
      <path d="m9 18 6-6 6-6"></path>
    </svg>
  </button>
</div>

<style>
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 80;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.25rem;
    background: color-mix(in srgb, var(--color-bg) 88%, transparent);
    backdrop-filter: blur(16px);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 0.25s ease,
      visibility 0.25s ease;
  }

  .lightbox[data-open="true"] {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .lightbox-stage {
    margin: 0;
    display: flex;
    max-width: min(1200px, 100%);
    max-height: calc(100dvh - 5rem);
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .lightbox-stage img {
    display: block;
    max-width: 100%;
    max-height: calc(100dvh - 6.5rem);
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 0.75rem;
    border: 1px solid color-mix(in srgb, var(--color-line) 50%, transparent);
    box-shadow: 0 24px 64px rgb(0 0 0 / 0.35);
  }

  .lightbox-counter {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    color: var(--color-faint);
  }

  .lightbox-close,
  .lightbox-nav {
    position: absolute;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 9999px;
    border: 1px solid color-mix(in srgb, var(--color-line) 60%, transparent);
    background: color-mix(in srgb, var(--color-bg) 75%, transparent);
    color: var(--color-ink);
    backdrop-filter: blur(8px);
    cursor: pointer;
    transition:
      background-color 0.25s ease,
      border-color 0.25s ease,
      color 0.25s ease;
  }

  .lightbox-close {
    top: 1rem;
    right: 1rem;
  }

  .lightbox-nav--prev {
    left: 1rem;
    top: 50%;
    translate: 0 -50%;
  }

  .lightbox-nav--next {
    right: 1rem;
    top: 50%;
    translate: 0 -50%;
  }

  @media (hover: hover) {
    .lightbox-close:hover,
    .lightbox-nav:hover {
      border-color: color-mix(in srgb, var(--color-accent) 45%, transparent);
      color: var(--color-accent);
    }
  }

  @media (max-width: 640px) {
    .lightbox-nav--prev {
      left: 0.5rem;
    }

    .lightbox-nav--next {
      right: 0.5rem;
    }
  }
</style>
