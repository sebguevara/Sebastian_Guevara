---
import type { InterestItem } from "@/lib/cv";

type Props = InterestItem;

const { name, keywords } = Astro.props;
---

<div class="card p-4 sm:p-5" data-animate="reveal">
  <h4 class="text-sm font-semibold text-ink">{name}</h4>
  <ul class="mt-3 flex flex-wrap gap-1.5">
    {
      keywords.map((keyword) => (
        <li>
          <span class="chip">{keyword}</span>
        </li>
      ))
    }
  </ul>
</div>
