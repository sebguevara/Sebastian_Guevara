---
import Github from "@/components/icons/brands/Github.astro";
import Link from "@/components/icons/Link.astro";
import Carousel from "@/components/ui/Carousel.astro";
import LinkButton from "@/components/ui/LinkButton.astro";
import { getCopy } from "@/consts/copy";
import { getLocale, localizePath } from "@/consts/locale";
import type { ProjectItem } from "@/lib/cv";

type Props = ProjectItem;

const locale = getLocale(Astro.currentLocale);
const copy = getCopy(locale);

const {
  slug,
  image,
  images,
  name,
  description,
  isActive,
  category,
  url,
  github,
  technologies,
  highlights,
} = Astro.props;

const gallery = images.length > 0 ? images : [image];
const detailUrl = localizePath(`/projects/${slug}`, locale);
---

<article
  class="card group flex cursor-pointer flex-col overflow-hidden"
  data-animate="reveal"
  data-card-href={detailUrl}
>
  <div class="relative w-full shrink-0">
    <Carousel
      images={gallery}
      alt={name}
      aspect="aspect-[2/1] lg:aspect-[16/9]"
      transitionName={`project-media-${slug}`}
    >
      <div
        class="pointer-events-none absolute inset-x-0 bottom-0 h-16 bg-linear-to-t from-surface/70 to-transparent"
      ></div>
      <div class="pointer-events-none absolute right-4 top-4 flex gap-2">
        {
          category && (
            <span class="chip bg-bg/70 backdrop-blur-md">{category}</span>
          )
        }
        {
          isActive && (
            <span class="chip border-accent/30 bg-bg/70 text-accent backdrop-blur-md">
              <span class="size-1.5 rounded-full bg-accent" />
              {copy.projects.live}
            </span>
          )
        }
      </div>
    </Carousel>
  </div>

  <div class="flex flex-1 flex-col p-5 sm:p-6">
    <h3 class="text-xl font-semibold tracking-tight text-ink">
      <a
        href={detailUrl}
        class="transition-colors duration-300 hover:text-accent"
        transition:name={`project-title-${slug}`}
      >
        {name}
      </a>
    </h3>
    <p class="mt-3 line-clamp-3 text-sm leading-relaxed text-muted">
      {description}
    </p>

    {
      highlights && highlights.length > 0 && (
        <p class="mt-3 flex flex-wrap gap-x-2.5 gap-y-1 font-mono text-[0.6875rem] text-faint">
          {highlights.map((tag) => (
            <span>#{tag}</span>
          ))}
        </p>
      )
    }

    <ul class="mt-auto flex flex-wrap gap-2 pt-5">
      {
        technologies.map((tech) => (
          <li>
            <span class="chip">{tech}</span>
          </li>
        ))
      }
    </ul>

    {
      (github || url) && (
        <footer class="mt-5 flex flex-wrap gap-3">
          {github && (
            <LinkButton href={github}>
              <Github class="size-4" />
              {copy.projects.code}
            </LinkButton>
          )}
          {url && (
            <LinkButton href={url}>
              <Link class="size-4" />
              {copy.projects.preview}
            </LinkButton>
          )}
        </footer>
      )
    }
  </div>
</article>
