---
const { class: className } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 32 32"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <rect
    x="1"
    y="1"
    width="30"
    height="30"
    rx="9"
    fill="currentColor"
    fill-opacity="0.08"
    stroke="currentColor"
    stroke-opacity="0.3"
    stroke-width="1.5"></rect>
  <text
    x="16"
    y="21"
    text-anchor="middle"
    font-family="Inter, system-ui, sans-serif"
    font-size="12"
    font-weight="700"
    letter-spacing="0.5"
    fill="currentColor">SG</text>
</svg>
