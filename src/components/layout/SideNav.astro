---
import About from "@/components/icons/About.astro";
import Briefcase from "@/components/icons/Briefcase.astro";
import FileCode from "@/components/icons/Filecode.astro";
import School from "@/components/icons/School.astro";
import Github from "@/components/icons/brands/Github.astro";
import Linkedin from "@/components/icons/brands/Linkedin.astro";
import Email from "@/components/icons/brands/Email.astro";
import Logo from "@/components/icons/Logo.astro";
import LanguageToggle from "@/components/layout/LanguageToggle.astro";
import ThemeToggle from "@/components/layout/ThemeToggle.astro";
import { getCopy } from "@/consts/copy";
import { getLocale, localizePath } from "@/consts/locale";
import { getNav, getSocial } from "@/consts/navigation";

const locale = getLocale(Astro.currentLocale);
const copy = getCopy(locale);
const nav = getNav(locale);
const social = getSocial(locale);
const homeUrl = `${localizePath("/", locale)}#home`;

const Icons: Record<string, any> = {
  About,
  Briefcase,
  FileCode,
  School,
  Logo,
  Github,
  Linkedin,
  Email,
};
---

<aside
  class="fixed left-0 top-0 z-40 hidden h-dvh w-20 flex-col items-center justify-between border-r border-line/60 bg-bg/60 py-6 backdrop-blur-md lg:flex"
>
  <a
    href={homeUrl}
    aria-label={copy.nav.home}
    class="transition-opacity hover:opacity-70"
  >
    <Logo class="w-8" />
  </a>

  <nav aria-label={copy.nav.aria}>
    <ul class="flex flex-col items-center gap-2">
      {
        nav.map((item) => {
          const Icon = Icons[item.icon];
          return (
            <li>
              <a
                href={item.url}
                data-section-link={item.label}
                class="rail-link group flex flex-col items-center gap-1.5 rounded-2xl px-3 py-2.5 text-muted transition-colors duration-300"
                aria-label={item.title}
              >
                <Icon class="size-5" />
                <span class="text-[0.625rem] font-medium tracking-wide">
                  {item.title}
                </span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>

  <div class="flex flex-col items-center gap-4">
    <ThemeToggle />
    <LanguageToggle />
    <div class="h-6 w-px bg-line"></div>
    {
      social.map((item) => {
        const Icon = Icons[item.icon];
        return (
          <a
            href={item.url}
            target="_blank"
            rel="noopener"
            aria-label={item.label}
            class="text-faint transition-colors duration-300 hover:text-accent"
          >
            <Icon class="size-5" />
          </a>
        );
      })
    }
    <div class="mt-2 h-10 w-px bg-line"></div>
  </div>
</aside>

<style>
  .rail-link:global(.active) {
    color: var(--color-accent);
    background-color: color-mix(in srgb, var(--color-accent) 10%, transparent);
  }

  @media (hover: hover) {
    .rail-link:hover {
      color: var(--color-ink);
      background-color: color-mix(in srgb, var(--color-ink) 6%, transparent);
    }

    .rail-link:global(.active):hover {
      color: var(--color-accent-strong);
    }
  }
</style>
