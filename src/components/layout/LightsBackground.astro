<div class="lights fixed inset-0 -z-40 pointer-events-none" aria-hidden="true">
</div>

<style>
  /* Brand backdrop: a pre-blurred version of the splatter image
     (background-2-soft.webp, generated with sharp) renders as a soft ambient
     rose wash — no expensive runtime blur. On dark, `screen` removes the
     image's black ground so only warm light remains. On light, the same soft
     image acts as a luminance mask over the accent color. NoiseBackground
     layers the sandy grain on top. */
  .lights {
    background: url("/img/effects/background-2-soft.webp") center / cover
      no-repeat;
    mix-blend-mode: screen;
    opacity: 0.45;
    filter: blur(28px) saturate(1.25);
    transform: translateZ(0);
  }

  @media (min-width: 1024px) {
    .lights {
      opacity: 0.38;
    }
  }

  :root[data-theme="light"] .lights {
    background: var(--color-accent);
    mix-blend-mode: normal;
    mask: url("/img/effects/background-2-soft.webp") center / cover no-repeat
      luminance;
    opacity: 0.28;
    filter: none;
  }

  @media (min-width: 1024px) {
    :root[data-theme="light"] .lights {
      opacity: 0.2;
    }
  }
</style>
