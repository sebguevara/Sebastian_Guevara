<div class="lights fixed inset-0 -z-40 pointer-events-none" aria-hidden="true">
</div>

<style>
  /* Brand backdrop: soft ambient wash from the splatter image.
     Dark uses screen so only warm light remains; light masks accent through
     the same image. Keep shapes quiet so the sandy grain can lead. */
  .lights {
    background: url("/img/effects/background-2-soft.webp") center / cover
      no-repeat;
    mix-blend-mode: screen;
    opacity: 0.2;
    filter: blur(36px) saturate(1.05);
    transform: translateZ(0);
  }

  @media (min-width: 1024px) {
    .lights {
      opacity: 0.16;
    }
  }

  :root[data-theme="light"] .lights {
    background: var(--color-accent);
    mix-blend-mode: normal;
    mask: url("/img/effects/background-2-soft.webp") center / cover no-repeat
      luminance;
    opacity: 0.14;
    filter: blur(20px);
  }

  @media (min-width: 1024px) {
    :root[data-theme="light"] .lights {
      opacity: 0.1;
    }
  }
</style>
